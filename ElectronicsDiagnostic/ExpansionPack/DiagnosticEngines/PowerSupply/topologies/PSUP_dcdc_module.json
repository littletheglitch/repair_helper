{
  "topology_id": "PSUP_dcdc_module",
  "name": "Isolated DC-DC module (DC input, transformer isolated)",
  "mains_powered": false,
  "isolated": true,
  "typical_power_level_w": 30,
  "stages": [
    {
      "id": "input_protection",
      "description": "Input fuse, reverse-polarity diode, input cap",
      "components": [
        "fuse",
        "reverse_diode",
        "input_cap"
      ],
      "diagnostic_signals": {
        "input_voltage": "in_range"
      },
      "fail_note": "No input voltage. Check the input fuse, reverse-polarity diode, and the input source.",
      "depends_on": [],
      "side": "low_voltage"
    },
    {
      "id": "input_filter",
      "description": "Input filter cap + decoupling",
      "components": [
        "input_cap"
      ],
      "diagnostic_signals": {
        "input_voltage": "in_range"
      },
      "fail_note": "Input present at connector but wrong at the regulator input pin. Check the input trace and decoupling.",
      "depends_on": [
        "input_protection"
      ],
      "side": "low_voltage"
    },
    {
      "id": "startup_supply",
      "description": "Controller VCC (internal LDO or external bias)",
      "components": [
        "vcc_cap",
        "bias_diode"
      ],
      "diagnostic_signals": {
        "vcc": "in_range"
      },
      "fail_note": "Controller VCC missing. The IC cannot run. Check the VCC decoupling cap and the VCC feed (internal LDO or bias winding).",
      "depends_on": [
        "input_protection"
      ],
      "side": "low_voltage"
    },
    {
      "id": "pwm_controller",
      "description": "PWM controller enable + reference",
      "components": [
        "controller_ic"
      ],
      "diagnostic_signals": {
        "en": "in_range",
        "vref": "in_range"
      },
      "fail_note": "Controller not enabled or no reference. Check EN source and the internal Vref.",
      "depends_on": [
        "startup_supply"
      ],
      "side": "low_voltage"
    },
    {
      "id": "main_switch",
      "description": "Primary switch",
      "components": [
        "primary_fet",
        "gate_driver"
      ],
      "diagnostic_signals": {
        "switching": "in_range",
        "gate_drive": "in_range"
      },
      "fail_note": "Primary switch fault.",
      "depends_on": [
        "pwm_controller"
      ],
      "side": "low_voltage"
    },
    {
      "id": "transformer",
      "description": "Isolation transformer",
      "components": [
        "transformer"
      ],
      "diagnostic_signals": {
        "switching": "in_range"
      },
      "fail_note": "Transformer fault.",
      "depends_on": [
        "main_switch"
      ],
      "side": "low_voltage"
    },
    {
      "id": "rectification_secondary",
      "description": "Secondary rectifier",
      "components": [
        "secondary_diode"
      ],
      "diagnostic_signals": {
        "output_voltage": "in_range"
      },
      "fail_note": "Secondary rectifier fault.",
      "depends_on": [
        "main_switch"
      ],
      "side": "secondary"
    },
    {
      "id": "output_filter",
      "description": "Output cap + choke",
      "components": [
        "output_choke",
        "output_cap"
      ],
      "diagnostic_signals": {
        "output_voltage": "in_range",
        "output_ripple": "in_range"
      },
      "fail_note": "Output filter fault.",
      "depends_on": [
        "rectification_secondary",
        "inductor",
        "transformer"
      ],
      "side": "secondary"
    },
    {
      "id": "feedback",
      "description": "Isolated feedback: secondary TL431 + optocoupler across isolation barrier",
      "components": [
        "TL431",
        "optocoupler",
        "fb_divider"
      ],
      "diagnostic_signals": {
        "fb": "in_range",
        "opto_ctr": "in_range"
      },
      "fail_note": "Feedback path fault across the isolation barrier. Check the TL431 reference, the optocoupler CTR, and the secondary-side feedback divider. An open optocoupler drives the primary to max duty; a shorted TL431 drives min duty.",
      "depends_on": [
        "output_filter"
      ],
      "side": "secondary"
    },
    {
      "id": "protection",
      "description": "PGOOD / OVP / OCP / thermal",
      "components": [
        "pgood_pullup"
      ],
      "diagnostic_signals": {
        "pgood": "in_range"
      },
      "fail_note": "PGOOD not asserted or protection tripping. Check the PGOOD pull-up and the OVP/OCP monitors.",
      "depends_on": [
        "feedback"
      ],
      "side": "secondary"
    }
  ],
  "fault_patterns": [
    {
      "pattern": "no_output",
      "likely_stages": [
        "main_switch",
        "transformer",
        "rectification_secondary"
      ],
      "notes": "DC-DC module: isolated buck-like."
    },
    {
      "pattern": "wrong_voltage",
      "likely_stages": [
        "feedback",
        "output_filter"
      ],
      "notes": "Output present but wrong voltage. Check the feedback divider and the reference."
    },
    {
      "pattern": "unstable",
      "likely_stages": [
        "output_filter",
        "feedback"
      ],
      "notes": "Output unstable/oscillating. Check output caps, feedback compensation, ESR."
    }
  ],
  "schema_version": "1.1.0"
}