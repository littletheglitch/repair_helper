{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "discrete_semiconductor.schema.json",
  "title": "Discrete Semiconductor Record (diode / Schottky / TVS / BJT)",
  "description": "Verified record of a discrete semiconductor. All electrical ratings must be sourced from a manufacturer datasheet. Missing values must be null with verification_status='unknown'.",
  "type": "object",
  "required": [
    "record_id", "part_number", "manufacturer", "category", "package",
    "pin_count", "pinout", "verification_status", "datasheet_url",
    "datasheet_source", "source_date", "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "pattern": "^DISC_[A-Z0-9_]+$" },
    "part_number": { "type": "string", "minLength": 1 },
    "manufacturer": { "type": "string", "minLength": 1 },
    "manufacturer_short": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["diode", "schottky_diode", "tvs_diode", "zener_diode", "bjt_npn", "bjt_pnp", "esd_diode"]
    },
    "package": { "type": "string", "minLength": 1 },
    "pin_count": { "type": "integer", "minimum": 1 },
    "pinout": {
      "type": "object",
      "description": "For diodes: anode/cathode. For BJTs: base/collector/emitter.",
      "additionalProperties": { "type": "string" }
    },
    "electrical_characteristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vrrm_v": { "type": ["number", "null"], "description": "Reverse voltage (diodes/TVS)." },
        "if_avg_a": { "type": ["number", "null"], "description": "Average forward current (diodes)." },
        "ifsm_a": { "type": ["number", "null"], "description": "Surge forward current (diodes)." },
        "vf_v": { "type": ["number", "null"], "description": "Forward voltage at rated current." },
        "vf_conditions": { "type": "string" },
        "vbr_v": { "type": ["number", "null"], "description": "Breakdown voltage (TVS/Zener)." },
        "vc_v": { "type": ["number", "null"], "description": "Clamping voltage (TVS)." },
        "pp_w": { "type": ["number", "null"], "description": "Peak pulse power (TVS)." },
        "vceo_v": { "type": ["number", "null"], "description": "Collector-emitter voltage (BJT)." },
        "ic_a": { "type": ["number", "null"], "description": "Continuous collector current (BJT)." },
        "hfe_min": { "type": ["number", "null"], "description": "DC current gain min (BJT)." },
        "pd_w": { "type": ["number", "null"], "description": "Power dissipation." },
        "thermal_r_ja_c_per_w": { "type": ["number", "null"] },
        "operating_temp_range_c": {
          "type": "object",
          "properties": {
            "min": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] }
          }
        }
      }
    },
    "typical_applications": { "type": "array", "items": { "type": "string" } },
    "datasheet_url": { "type": "string", "format": "uri" },
    "datasheet_source": { "type": "string", "minLength": 1 },
    "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verification_status": { "type": "string", "enum": ["verified", "partial", "unknown"] },
    "verification_notes": { "type": "string" },
    "replacement_notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "schema_version": { "type": "string", "enum": ["1.0.0"] }
  }
}
