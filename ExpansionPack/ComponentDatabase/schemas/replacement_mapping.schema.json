{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "replacement_mapping.schema.json",
  "title": "Replacement Mapping Record",
  "description": "Evidence-backed mapping between an original part and a candidate replacement. Compatibility MUST be justified by an explicit evidence list. Never invent a COMPATIBLE classification without evidence covering package, pinout, voltage, current, RDS_on (for MOSFETs), gate drive / gate charge (for MOSFETs), and thermal.",
  "type": "object",
  "required": [
    "mapping_id",
    "original_part",
    "candidate_part",
    "component_type",
    "classification",
    "evidence",
    "datasheet_urls",
    "verification_status",
    "source_date",
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "mapping_id": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "original_part": { "type": "string", "minLength": 1 },
    "candidate_part": { "type": "string", "minLength": 1 },
    "component_type": { "type": "string", "enum": ["IC", "MOSFET"] },
    "classification": {
      "type": "string",
      "enum": ["COMPATIBLE", "CONDITIONAL", "NOT_RECOMMENDED", "UNKNOWN"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "verdict", "note"],
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "package",
              "pinout",
              "voltage_rating",
              "current_rating",
              "rds_on",
              "gate_drive",
              "gate_charge",
              "thermal",
              "switching",
              "control_logic",
              "enable_threshold",
              "feedback_topology",
              "operating_frequency",
              "other"
            ]
          },
          "verdict": { "type": "string", "enum": ["match", "mismatch", "conditional", "unknown"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conditions": {
      "type": "array",
      "description": "Required conditions for CONDITIONAL classifications. Required to be non-empty when classification=CONDITIONAL.",
      "items": { "type": "string" }
    },
    "datasheet_urls": {
      "type": "object",
      "required": ["original", "candidate"],
      "additionalProperties": false,
      "properties": {
        "original": { "type": "string", "format": "uri" },
        "candidate": { "type": "string", "format": "uri" }
      }
    },
    "datasheet_sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original": { "type": "string" },
        "candidate": { "type": "string" }
      }
    },
    "verification_status": { "type": "string", "enum": ["verified", "partial", "unknown"] },
    "verification_notes": { "type": "string" },
    "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "schema_version": { "type": "string", "enum": ["1.0.0"] }
  }
}
